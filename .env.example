# Server
PORT=8000

# Auth
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Database
DATABASE_URL=postgresql://acefone:acefone@localhost:5432/acefone

# OpenAI
OPENAI_API_KEY=sk-...

# Notion
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=           # Blog SEO Reviews DB ID
BLOG_TRACKER_DATABASE_ID=     # Blog Tracker DB ID
NOTION_WEBHOOK_SECRET=        # Optional — leave empty to skip HMAC verification

# Ingest endpoint
INGEST_SECRET=                # Optional — leave empty to skip auth

# Blog Reviewer agent
BLOG_REVIEW_DB_ID=            # Notion DB ID for "Existing Blogs DB"

# AES-256-GCM key for provider credentials at rest (openssl rand -hex 32)
ENCRYPTION_KEY=

# Optional: raises the GitHub import rate limit
GITHUB_TOKEN=

# Folder containing your Obsidian vault(s); mounted read-only at /vaults
OBSIDIAN_VAULT_HOST_PATH=./vaults
